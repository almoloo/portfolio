---
import Layout from '../layouts/Layout.astro';
import Button from '../components/core/button.astro';
import IconButton from '../components/core/icon-button.astro';
import Tag from '../components/content/tag.astro';
import Card from '../components/content/card.astro';
import Tooltip from '../components/feedback/tooltip.astro';
import Input from '../components/forms/input.astro';
import Switch from '../components/forms/switch.astro';
import Tabs from '../components/navigation/tabs.astro';
import ResumeHeader from '../components/resume/resume-header.astro';
import ResumeSection from '../components/resume/resume-section.astro';
import ExperienceItem from '../components/resume/experience-item.astro';
import EducationItem from '../components/resume/education-item.astro';
import SkillList from '../components/resume/skill-list.astro';
---

<Layout title="Design system">
	<main class="page">
		<section>
			<h2>Button</h2>
			<div class="row">
				<Button variant="primary" size="sm">Primary sm</Button>
				<Button variant="primary" size="md">Primary md</Button>
				<Button variant="primary" size="lg">Primary lg</Button>
			</div>
			<div class="row">
				<Button variant="secondary" size="sm">Secondary sm</Button>
				<Button variant="secondary" size="md">Secondary md</Button>
				<Button variant="secondary" size="lg">Secondary lg</Button>
			</div>
			<div class="row">
				<Button variant="ghost" size="sm">Ghost sm</Button>
				<Button variant="ghost" size="md">Ghost md</Button>
				<Button variant="ghost" size="lg">Ghost lg</Button>
			</div>
			<div class="row">
				<Button variant="primary" disabled>Disabled</Button>
			</div>
		</section>

		<section>
			<h2>IconButton</h2>
			<div class="row">
				<IconButton size="sm" label="Small action">↗</IconButton>
				<IconButton size="md" label="Medium action">↗</IconButton>
				<IconButton size="lg" label="Large action">↗</IconButton>
				<IconButton label="Disabled action" disabled>×</IconButton>
			</div>
		</section>

		<section>
			<h2>Tag</h2>
			<div class="row">
				<Tag>Default</Tag>
				<Tag variant="accent">Accent</Tag>
			</div>
		</section>

		<section>
			<h2>Card</h2>
			<div class="row">
				<Card
					title="Project without image"
					description="Falls back to the dither pattern."
					tags={['astro', 'css']}
				/>
				<Card
					title="Project with image"
					description="Uses a real thumbnail."
					tags={['design system']}
					image="https://picsum.photos/520/300"
				/>
			</div>
		</section>

		<section>
			<h2>Tooltip</h2>
			<div class="row">
				<Tooltip label="A helpful hint">
					<Button variant="secondary" size="md">Hover me</Button>
				</Tooltip>
			</div>
		</section>

		<section>
			<h2>Input</h2>
			<div class="row">
				<Input label="Name" placeholder="Ali Mousavi" />
				<Input label="Email" placeholder="you@example.com" value="taken@example.com" error="That email is already taken." />
			</div>
		</section>

		<section>
			<h2>Switch</h2>
			<div class="row">
				<Switch label="Unchecked" />
				<Switch label="Checked" checked />
			</div>
		</section>

		<section>
			<h2>Tabs</h2>
			<div class="row" style="flex-direction: column; align-items: flex-start; gap: var(--space-4);">
				<Tabs items={[{ label: 'Overview', value: 'overview' }, { label: 'Details', value: 'details' }, { label: 'Notes', value: 'notes' }]} />
				<Tabs items={[{ label: 'First', value: 'first' }, { label: 'Second', value: 'second' }]} active="second" />
			</div>
		</section>

		<section>
			<h2>Resume</h2>
			<div class="resume">
				<ResumeHeader
					name="Ali Mousavi"
					title="Software Engineer"
					links={[
						{ label: 'email', href: 'mailto:hello@example.com' },
						{ label: 'github', href: 'https://github.com' },
						{ label: 'linkedin', href: 'https://linkedin.com' },
					]}
				/>
				<ResumeSection title="Experience">
					<ExperienceItem
						role="Senior Frontend Engineer"
						org="Acme Co"
						period="2022 — present"
						notes="Led the redesign of the core product's design system."
					/>
					<ExperienceItem
						role="Frontend Engineer"
						org="Widgets Inc"
						period="2019 — 2022"
					/>
				</ResumeSection>
				<ResumeSection title="Education">
					<EducationItem degree="B.S. Computer Science" school="State University" period="2015 — 2019" />
				</ResumeSection>
				<ResumeSection title="Skills">
					<SkillList skills={['astro', 'typescript', 'css', 'design systems']} />
				</ResumeSection>
			</div>
		</section>
	</main>
</Layout>

<style>
	.page {
		max-width: 900px;
		margin: 0 auto;
		padding: var(--space-8);
		display: flex;
		flex-direction: column;
		gap: var(--space-8);
	}

	.row {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	.resume {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
		max-width: 600px;
	}
</style>
