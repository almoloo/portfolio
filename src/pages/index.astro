---
import Layout from '../layouts/Layout.astro';
import Tag from '../components/content/tag.astro';
import Tabs from '../components/navigation/tabs.astro';
import ResumeSection from '../components/resume/resume-section.astro';
import ExperienceItem from '../components/resume/experience-item.astro';
import EducationItem from '../components/resume/education-item.astro';
import SkillList from '../components/resume/skill-list.astro';
import { resume } from '../data/resume';

const TABS_NAME = 'main-tabs';
---

<Layout title="Ali Mousavi">
	<div class="split">
		<div class="left">
			<header class="header">
				<div class="name">Ali Mousavi</div>
				<p class="tagline">Frontend engineer &amp; interactive designer</p>
				<div class="tags">
					<Tag variant="accent">remote</Tag>
					<Tag variant="accent">available q4 2026</Tag>
				</div>
				<p class="bio">
					10 years writing interfaces, specializing in video platforms and crypto products. I like small
					tools, tight loops, and things that load fast.
				</p>
			</header>

			<div class="tabs-wrap">
				<Tabs
					name={TABS_NAME}
					active="portfolio"
					items={[
						{ label: 'Resume', value: 'resume' },
						{ label: 'Portfolio', value: 'portfolio' },
					]}
				/>
			</div>

			<div class="panes">
				<div class="pane pane-resume">
					<div class="contact-links">
						{resume.header.links.map((link, i) => (
							<>
								{i > 0 && <span class="separator">·</span>}
								<a href={link.href || '#'}>{link.label}</a>
							</>
						))}
					</div>

					<p class="summary">{resume.summary}</p>

					<ResumeSection title="Experience">
						{resume.experience.map((entry) => (
							<ExperienceItem role={entry.role} org={entry.org} period={entry.period} notes={entry.notes} />
						))}
					</ResumeSection>

					<ResumeSection title="Achievements">
						<ul class="achievements">
							{resume.achievements.map((achievement) => (
								<li>
									<strong>{achievement.result}</strong>
									{achievement.project && <> — {achievement.project}</>}
								</li>
							))}
						</ul>
					</ResumeSection>

					<ResumeSection title="Education">
						{resume.education.map((entry) => (
							<EducationItem degree={entry.degree} school={entry.school} period={entry.period} />
						))}
					</ResumeSection>

					<ResumeSection title="Skills">
						<div class="skill-groups">
							{resume.skillGroups.map((group) => (
								<div>
									<p class="skill-group-label">{group.label}</p>
									<SkillList skills={group.skills} />
								</div>
							))}
						</div>
					</ResumeSection>

					<ResumeSection title="Languages">
						<p class="languages">
							{resume.languages.map((entry) => `${entry.language} — ${entry.level}`).join(', ')}
						</p>
					</ResumeSection>
				</div>
				<div class="pane pane-portfolio">Portfolio content goes here</div>
			</div>
		</div>

		<div class="right">
			<span class="empty-state">select a project</span>
		</div>
	</div>
</Layout>

<style>
	.split {
		display: flex;
		min-height: 100vh;
	}

	.left {
		width: 50%;
		display: flex;
		flex-direction: column;
		border-right: 1px solid var(--border-default);
		overflow-y: auto;
	}

	.right {
		width: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	@media (max-width: 768px) {
		.split {
			flex-direction: column;
		}

		.left,
		.right {
			width: 100%;
		}

		.left {
			border-right: none;
			border-bottom: 1px solid var(--border-default);
		}

		.right {
			min-height: 40vh;
		}
	}

	.header {
		padding: var(--space-12) var(--space-10) var(--space-6);
		border-bottom: 1px solid var(--border-default);
	}

	.name {
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		font-size: var(--text-3xl);
		margin-bottom: var(--space-2);
	}

	.tagline {
		font-family: var(--font-body);
		font-size: var(--text-md);
		color: var(--ink-700);
		margin: 0 0 var(--space-3);
	}

	.tags {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
		margin-bottom: var(--space-4);
	}

	.bio {
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--ink-700);
		max-width: 480px;
		margin: 0;
	}

	.tabs-wrap {
		padding: var(--space-4) var(--space-10) 0;
	}

	.panes {
		padding: var(--space-6) var(--space-10) var(--space-12);
		flex: 1;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--ink-700);
	}

	.pane {
		display: none;
		flex-direction: column;
		gap: var(--space-8);
	}

	.contact-links {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.contact-links .separator {
		color: var(--ink-500);
	}

	.summary {
		line-height: var(--leading-normal);
	}

	.achievements {
		margin: 0;
		padding-left: 1.1em;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.skill-groups {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.skill-group-label {
		font-family: var(--font-display);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--ink-700);
		margin: 0 0 var(--space-2);
	}

	.languages {
		margin: 0;
	}

	.left:has(#main-tabs-resume:checked) .pane-resume {
		display: flex;
	}

	.left:has(#main-tabs-portfolio:checked) .pane-portfolio {
		display: block;
	}

	.empty-state {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		color: var(--ink-500);
		opacity: 0.28;
	}
</style>
