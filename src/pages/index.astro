---
import Layout from '../layouts/Layout.astro';
import Tabs from '../components/navigation/tabs.astro';
import ResumeSection from '../components/resume/resume-section.astro';
import ExperienceItem from '../components/resume/experience-item.astro';
import EducationItem from '../components/resume/education-item.astro';
import SkillList from '../components/resume/skill-list.astro';
import { resume } from '../data/resume';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

const TABS_NAME = 'main-tabs';

const portfolioItems = (await getCollection('portfolio')).sort((a, b) => {
	const aTime = a.data.date?.getTime();
	const bTime = b.data.date?.getTime();
	if (aTime == null && bTime == null) return 0;
	if (aTime == null) return 1;
	if (bTime == null) return -1;
	return bTime - aTime;
});

const cssId = (id: string) => id.replace(/[^a-zA-Z0-9_-]/g, '-');

const renderedPortfolioItems = await Promise.all(
	portfolioItems.map(async (item) => ({ item, id: cssId(item.id), Content: (await render(item)).Content })),
);

const portfolioSelectionCss = renderedPortfolioItems
	.map(({ id }) => `.split:has(#portfolio-${id}:checked) #portfolio-detail-${id} { display: flex; }`)
	.concat(portfolioItems.length > 0 ? ['.split:has(.portfolio-radio:checked) .right .empty-state { display: none; }'] : [])
	.join('\n');
---

<Layout title="Ali Mousavi">
	<div class="split">
		<div class="left">
			<header class="header">
				<div class="name">Ali Mousavi</div>
				<p class="tagline">Frontend developer &amp; interface enthusiast</p>
				<div class="contact-links">
					{resume.header.links.map((link, i) => (
						<>
							{i > 0 && <span class="separator">·</span>}
							<a href={link.href || '#'}>{link.label}</a>
						</>
					))}
				</div>
				<p class="bio">
					10 years writing interfaces, specializing in video platforms and crypto products. I like small
					tools, tight loops, and things that load fast.
				</p>
			</header>

			<div class="tabs-wrap">
				<Tabs
					name={TABS_NAME}
					active="resume"
					items={[
						{ label: 'Resume', value: 'resume' },
						{ label: 'Portfolio', value: 'portfolio' },
					]}
				/>
			</div>

			<div class="panes">
				<div class="pane pane-resume">
					<p class="summary">{resume.summary}</p>

					<ResumeSection title="Experience">
						{resume.experience.map((entry) => (
							<ExperienceItem role={entry.role} org={entry.org} period={entry.period} notes={entry.notes} />
						))}
					</ResumeSection>

					<ResumeSection title="Achievements">
						<ul class="achievements">
							{resume.achievements.map((achievement) => (
								<li>
									<strong>{achievement.result}</strong>
									{achievement.project && <> — {achievement.project}</>}
								</li>
							))}
						</ul>
					</ResumeSection>

					<ResumeSection title="Education">
						{resume.education.map((entry) => (
							<EducationItem degree={entry.degree} school={entry.school} period={entry.period} />
						))}
					</ResumeSection>

					<ResumeSection title="Skills">
						<div class="skill-groups">
							{resume.skillGroups.map((group) => (
								<div>
									<p class="skill-group-label">{group.label}</p>
									<SkillList skills={group.skills} />
								</div>
							))}
						</div>
					</ResumeSection>

					<ResumeSection title="Languages">
						<p class="languages">
							{resume.languages.map((entry) => `${entry.language} — ${entry.level}`).join(', ')}
						</p>
					</ResumeSection>
				</div>
				<div class="pane pane-portfolio">
					{portfolioItems.length === 0 ? (
						<p class="portfolio-empty">No projects yet — check back soon.</p>
					) : (
						<div class="portfolio-list">
							{renderedPortfolioItems.map(({ item, id }) => (
								<>
									<input
										type="radio"
										name="portfolio-select"
										id={`portfolio-${id}`}
										class="portfolio-radio"
									/>
									<label for={`portfolio-${id}`} class="portfolio-row">
										<Image
											src={item.data.thumbnail}
											alt={item.data.title}
											width={64}
											height={64}
											class="portfolio-thumb"
										/>
										<div>
											<div class="portfolio-title">{item.data.title}</div>
											{item.data.date && (
												<div class="portfolio-date">
													{item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
												</div>
											)}
										</div>
									</label>
								</>
							))}
						</div>
					)}
				</div>
			</div>
		</div>

		<div class="right">
			<span class="empty-state">select a project</span>
			{renderedPortfolioItems.map(({ item, id, Content }) => (
				<div class="project-detail" id={`portfolio-detail-${id}`}>
					<Image
						src={item.data.thumbnail}
						alt={item.data.title}
						width={160}
						height={160}
						class="detail-thumb"
					/>
					{item.data.date && (
						<div class="detail-date">
							{item.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
						</div>
					)}
					<h2 class="detail-title">{item.data.title}</h2>
					{(item.data.githubUrl || item.data.demoUrl) && (
						<div class="detail-links">
							{item.data.githubUrl && (
								<a class="detail-link" href={item.data.githubUrl} target="_blank" rel="noopener noreferrer">
									GitHub
								</a>
							)}
							{item.data.demoUrl && (
								<a class="detail-link" href={item.data.demoUrl} target="_blank" rel="noopener noreferrer">
									Live demo
								</a>
							)}
						</div>
					)}
					<div class="detail-body">
						<Content />
					</div>
				</div>
			))}
		</div>
	</div>
</Layout>

{portfolioSelectionCss && <style set:html={portfolioSelectionCss}></style>}

<style>
	.split {
		display: flex;
		min-height: 100vh;
	}

	.left {
		width: 50%;
		display: flex;
		flex-direction: column;
		border-right: 1px solid var(--border-default);
		overflow-y: auto;
	}

	.right {
		width: 50%;
		overflow-y: auto;
	}

	@media (max-width: 768px) {
		.split {
			flex-direction: column;
		}

		.left,
		.right {
			width: 100%;
		}

		.left {
			border-right: none;
			border-bottom: 1px solid var(--border-default);
		}

		.right {
			min-height: 40vh;
		}
	}

	.header {
		padding: var(--space-12) var(--space-10) var(--space-6);
		border-bottom: 1px solid var(--border-default);
	}

	.name {
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		font-size: var(--text-3xl);
		margin-bottom: var(--space-1);
	}

	.tagline {
		font-family: var(--font-body);
		font-size: var(--text-md);
		color: var(--ink-700);
		margin: 0 0 var(--space-3);
	}

	.header .contact-links {
		margin-bottom: var(--space-4);
	}

	.bio {
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--ink-700);
		max-width: 480px;
		margin: 0;
	}

	.tabs-wrap {
		padding: var(--space-4) var(--space-10) 0;
	}

	.panes {
		padding: var(--space-6) var(--space-10) var(--space-12);
		flex: 1;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--ink-700);
	}

	.pane {
		display: none;
		flex-direction: column;
		gap: var(--space-8);
	}

	.contact-links {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.contact-links .separator {
		color: var(--ink-500);
	}

	.summary {
		line-height: var(--leading-normal);
	}

	.achievements {
		margin: 0;
		padding-left: 1.1em;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.skill-groups {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.skill-group-label {
		font-family: var(--font-display);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--ink-700);
		margin: 0 0 var(--space-2);
	}

	.languages {
		margin: 0;
	}

	.portfolio-empty {
		color: var(--ink-500);
	}

	.portfolio-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.portfolio-radio {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.portfolio-row {
		display: flex;
		gap: var(--space-4);
		align-items: center;
		cursor: pointer;
		padding: var(--space-3);
	}

	.portfolio-thumb {
		width: 64px;
		height: 64px;
		flex: none;
		object-fit: cover;
		border: 1px solid var(--border-default);
	}

	.portfolio-title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-base);
		color: var(--ink-900);
	}

	.portfolio-date {
		font-size: var(--text-xs);
		color: var(--ink-500);
	}

	.portfolio-radio:checked + .portfolio-row {
		background: var(--surface-sunken);
	}

	.portfolio-radio:focus-visible + .portfolio-row {
		outline: 2px solid var(--accent-500);
		outline-offset: 2px;
	}

	.left:has(#main-tabs-resume:checked) .pane-resume {
		display: flex;
	}

	.left:has(#main-tabs-portfolio:checked) .pane-portfolio {
		display: block;
	}

	.empty-state {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		color: var(--ink-500);
		opacity: 0.28;
	}

	.project-detail {
		display: none;
		flex-direction: column;
		gap: var(--space-8);
		padding: var(--space-12) var(--space-10);
	}

	.detail-thumb {
		width: 160px;
		height: 160px;
		object-fit: contain;
		padding: var(--space-4);
		background: var(--surface-card);
		border: 1px solid var(--border-default);
	}

	.detail-date {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		color: var(--ink-500);
	}

	.detail-title {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		margin: 0;
	}

	.detail-links {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}

	.detail-link {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		font-size: var(--text-sm);
		padding: 10px 16px;
		border-radius: var(--radius-pill);
		border: 1px solid var(--ink-900);
		background: var(--surface-card);
		color: var(--ink-900);
		text-decoration: none;
		transition: transform var(--duration-fast) var(--ease-linear);
	}

	.detail-link:hover {
		transform: translate(-1px, -1px);
	}

	.detail-body {
		font-family: var(--font-body);
		font-size: var(--text-base);
		color: var(--ink-700);
		line-height: var(--leading-normal);
	}

	.detail-body :global(p) {
		margin: 0 0 var(--space-4);
	}

	.detail-body :global(h2) {
		margin: var(--space-6) 0 var(--space-2);
	}

	.detail-body :global(h2:first-child) {
		margin-top: 0;
	}

	.detail-body :global(ul),
	.detail-body :global(ol) {
		margin: 0 0 var(--space-4);
	}

	.detail-body :global(img) {
		max-width: 100%;
		height: auto;
		display: block;
		margin: var(--space-6) 0;
		border: 1px solid var(--border-default);
	}
</style>
