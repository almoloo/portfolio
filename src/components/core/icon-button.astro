---
interface Props {
	size?: 'sm' | 'md' | 'lg';
	disabled?: boolean;
	label?: string;
}

const { size = 'md', disabled = false, label = 'action' } = Astro.props;
---

<button
	class:list={['icon-button', size]}
	disabled={disabled}
	aria-label={label}
	title={label}
>
	<slot />
</button>

<style>
	.icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--surface-card);
		border: 1px solid var(--ink-900);
		border-radius: var(--radius-0);
		color: var(--ink-900);
		cursor: pointer;
		box-shadow: none;
		transform: none;
		transition: transform var(--duration-fast) var(--ease-linear);
	}

	.icon-button:disabled {
		cursor: not-allowed;
		opacity: 0.45;
	}

	.icon-button:not(:disabled):hover {
		transform: translate(-1px, -1px);
	}

	.icon-button:not(:disabled):active {
		transform: translate(1px, 1px);
	}

	.icon-button.sm {
		width: 32px;
		height: 32px;
	}

	.icon-button.md {
		width: 40px;
		height: 40px;
	}

	.icon-button.lg {
		width: 48px;
		height: 48px;
	}
</style>
