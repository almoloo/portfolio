---
interface Props {
	role: string;
	org?: string;
	period?: string;
	notes?: string | string[];
}

const { role, org, period, notes } = Astro.props;
---

<div class="item">
	<div class="row">
		<span class="role">{role}{org && <> · {org}</>}</span>
		{period && <span class="period">{period}</span>}
	</div>
	{notes && (Array.isArray(notes) ? (
		<ul class="notes-list">
			{notes.map((note) => <li>{note}</li>)}
		</ul>
	) : (
		<p class="notes">{notes}</p>
	))}
</div>

<style>
	.row {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		align-items: baseline;
	}

	.role {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--text-base);
	}

	.period {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		color: var(--ink-500);
		white-space: nowrap;
	}

	.notes {
		margin: 4px 0 0;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--ink-700);
	}

	.notes-list {
		margin: 4px 0 0;
		padding-left: 1.1em;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--ink-700);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
</style>
